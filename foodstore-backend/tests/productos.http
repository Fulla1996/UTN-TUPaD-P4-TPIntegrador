@baseUrl = http://localhost:8000

### 1. Obtener las unidades de medida para identificar una unidad contable
# @name obtenerUnidades
GET {{baseUrl}}/unidades-medida/
Accept: application/json


### 2. Crear el primer producto
# @name crearProducto
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "Producto de prueba A",
    "descripcion": "Producto para probar los endpoints",
    "precio_base": 1500.50,
    "stock_cantidad": 5.500,
    "disponible": true,
    "unidad_venta_id": 1
}


### 3. Crear un segundo producto
# @name crearSegundoProducto
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "Producto de prueba B",
    "descripcion": "Segundo producto para las pruebas",
    "precio_base": 2500.00,
    "stock_cantidad": 10.000,
    "disponible": true,
    "unidad_venta_id": 1,
    "imagenes_url": ["link.com", "otro_link.com"]
}


### 4. Crear un producto con nombre repetido (409)
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "Producto de prueba A",
    "descripcion": "Este producto tiene un nombre repetido",
    "precio_base": 2000.00,
    "stock_cantidad": 1.000,
    "disponible": true,
    "unidad_venta_id": 1
}


### 5. Crear un producto con unidad de medida inexistente (404)
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "Producto con unidad inexistente",
    "descripcion": "Prueba de clave foránea inexistente",
    "precio_base": 1000.00,
    "stock_cantidad": 1.000,
    "disponible": true,
    "unidad_venta_id": 999999
}


### 6. Crear un producto con datos inválidos (422)
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "AB",
    "descripcion": "Nombre demasiado corto",
    "precio_base": -100.00,
    "stock_cantidad": 1.000,
    "disponible": true,
    "unidad_venta_id": 1
}


### 7. Crear un producto con stock negativo (422)
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "Producto con stock negativo",
    "descripcion": "Prueba de validación de stock",
    "precio_base": 1000.00,
    "stock_cantidad": -1.000,
    "disponible": true,
    "unidad_venta_id": 1
}


### 8. Crear un producto con stock decimal y unidad contable (422)
# @name stockDecimalContable
POST {{baseUrl}}/productos/
Content-Type: application/json

{
    "nombre": "Producto contable con stock decimal",
    "descripcion": "Una unidad contable no debe admitir stock fraccionario",
    "precio_base": 1000.00,
    "stock_cantidad": 1.500,
    "disponible": true,
    "unidad_venta_id": 5
}


### 9. Listar todos los productos
# @name listarProductos
GET {{baseUrl}}/productos/
Accept: application/json


### 10. Filtrar productos activos
GET {{baseUrl}}/productos/?activo=true
Accept: application/json


### 11. Filtrar productos disponibles
GET {{baseUrl}}/productos/?disponible=true
Accept: application/json


### 12. Filtrar productos con stock
GET {{baseUrl}}/productos/?hay_stock=true
Accept: application/json


### 13. Filtrar productos sin stock
GET {{baseUrl}}/productos/?hay_stock=false
Accept: application/json


### 14. Buscar productos por nombre
GET {{baseUrl}}/productos/?search=B
Accept: application/json


### 15. Combinar filtros del listado
GET {{baseUrl}}/productos/?activo=true&disponible=true&hay_stock=true&search=Producto
Accept: application/json


### 16. Consultar el primer producto por ID
# @name obtenerProducto
GET {{baseUrl}}/productos/1
Accept: application/json


### 17. Consultar un producto inexistente (404)
GET {{baseUrl}}/productos/999999
Accept: application/json


### 18. Consultar hay_stock antes de modificar el stock
# El producto fue creado con stock_cantidad = 5.500.
# Se espera que hay_stock sea true.
GET {{baseUrl}}/productos/1
Accept: application/json


### 19. Actualizar el producto y llevar su stock a cero
# @name actualizarProducto
PUT {{baseUrl}}/productos/1
Content-Type: application/json

{
    "nombre": "Producto de prueba A",
    "descripcion": "Producto actualizado con stock agotado",
    "precio_base": 1600.00,
    "stock_cantidad": 0.000,
    "disponible": true,
    "unidad_venta_id": 1
}


### 20. Consultar hay_stock después de llevar el stock a cero
# Se espera que hay_stock sea false.
GET {{baseUrl}}/productos/1
Accept: application/json


### 21. Actualizar un producto inexistente (404)
PUT {{baseUrl}}/productos/999999
Content-Type: application/json

{
    "nombre": "Producto inexistente",
    "descripcion": "Prueba de actualización",
    "precio_base": 1000.00,
    "stock_cantidad": 1.000,
    "disponible": true,
    "unidad_venta_id": 1
}


### 22. Actualizar un producto con unidad inexistente (404)
PUT {{baseUrl}}/productos/1
Content-Type: application/json

{
    "nombre": "Producto de prueba A",
    "descripcion": "Prueba de unidad inexistente",
    "precio_base": 1600.00,
    "stock_cantidad": 1.000,
    "disponible": true,
    "unidad_venta_id": 999999
}


### 23. Actualizar un producto con nombre duplicado (409)
PUT {{baseUrl}}/productos/1
Content-Type: application/json

{
    "nombre": "Producto de prueba B",
    "descripcion": "Prueba de nombre duplicado",
    "precio_base": 1600.00,
    "stock_cantidad": 1.000,
    "disponible": true,
    "unidad_venta_id": 1
}


### 24. Actualizar un producto con datos inválidos (422)
PUT {{baseUrl}}/productos/1
Content-Type: application/json

{
    "nombre": "AB",
    "descripcion": "Nombre demasiado corto",
    "precio_base": -100.00,
    "stock_cantidad": 1.000,
    "disponible": true,
    "unidad_venta_id": 1
}


### 25. Dar de baja lógicamente el primer producto (204)
DELETE {{baseUrl}}/productos/1


### 26. Intentar dar de baja nuevamente el producto (409)
DELETE {{baseUrl}}/productos/1


### 27. Dar de baja un producto inexistente (404)
DELETE {{baseUrl}}/productos/999999


### 28. Consultar el producto dado de baja
# La consulta por ID debe seguir encontrándolo, pero activo debe ser false.
GET {{baseUrl}}/productos/1
Accept: application/json


### 29. Intentar actualizar un producto dado de baja (409)
PUT {{baseUrl}}/productos/1
Content-Type: application/json

{
    "nombre": "Producto de prueba A",
    "descripcion": "Intento de modificar un producto anulado",
    "precio_base": 1600.00,
    "stock_cantidad": 1.000,
    "disponible": true,
    "unidad_venta_id": 1
}

### Actualizar producto
PUT http://localhost:8000/productos/9
Content-Type: application/json

{
    "nombre": "Pizza especial actualizada",
    "descripcion": "Pizza con nuevos ingredientes",
    "precio_base": 13500,
    "stock_cantidad": 8,
    "disponible": true,
    "unidad_venta_id": 1
}